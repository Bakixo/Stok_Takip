# ─────────────────────────────────────────────────────────────
#  Stokta — ortam değişkenleri
#  Bu dosyayı ".env" olarak kopyala ve doldur:
#     Copy-Item .env.example .env
#  .env dosyası git'e GİRMEZ; gizli bilgiler burada kalır.
# ─────────────────────────────────────────────────────────────

# ── Veritabanı ───────────────────────────────────────────────
# Geliştirmede SQLite yeterli; dosya proje içinde oluşur.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Canlıda Postgres (Neon / Supabase ücretsiz plan):
#   DATABASE_PROVIDER="postgresql"
#   DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# ── Erişim ───────────────────────────────────────────────────
# Arkadaşının uygulamaya girerken yazacağı PIN. Cihazda hatırlanır.
ACCESS_PIN="1234"

# Oturum çerezini imzalar. Rastgele ve uzun olmalı.
# Üretmek için:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="buraya-rastgele-uzun-bir-dize-yapistir"

# ── E-posta (Gmail SMTP) ─────────────────────────────────────
# ÖNEMLİ: Buraya Gmail hesabının normal şifresi GİRMEZ.
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama (açık olmalı) > Uygulama şifreleri
# yolundan 16 haneli bir "uygulama şifresi" üret. Adımlar README'de.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="senin-adresin@gmail.com"
SMTP_PASS="abcd efgh ijkl mnop"

# Maillerde görünecek gönderen adı ve yanıt adresi.
MAIL_FROM_NAME="Stokta"
MAIL_REPLY_TO="senin-adresin@gmail.com"

# Worker üst üste başarısız olursa uyarı buraya gelir (senin adresin).
ADMIN_EMAIL="senin-adresin@gmail.com"

# Geliştirirken maili gerçekten göndermeyip konsola yazdırmak için "true" yap.
MAIL_DRY_RUN="false"

# Hoş geldin mailindeki hediye notu. Boş bırakırsan not bölümü hiç görünmez.
# Paragraf ayırmak için \n\n kullan.
WELCOME_NOTE=""

# ── Uygulama ─────────────────────────────────────────────────
# Maillerdeki butonlar bu adrese link verir. Sonunda / OLMASIN.
APP_URL="http://localhost:3000"
# Canlıda örn: APP_URL="https://stokta.up.railway.app"

# ── Worker ───────────────────────────────────────────────────
# Kontrol sıklığı (cron). Varsayılan: her 15 dakikada bir.
CRON_SCHEDULE="*/15 * * * *"

# Worker'ı web ile aynı süreçte çalıştır (Railway/Render tek servis dağıtımı).
# Ayrı bir worker süreci çalıştırıyorsan "false" bırak ve "npm run worker" kullan.
RUN_WORKER="false"

# ── Zara istemcisi (isteğe bağlı ince ayar) ──────────────────
# İstekler arası minimum bekleme ve üzerine eklenen rastgele pay (ms).
# Düşürmek Zara tarafında dikkat çeker; varsayılanları bırakmak en güvenlisi.
ZARA_MIN_GAP_MS="2000"
ZARA_JITTER_MS="6000"
